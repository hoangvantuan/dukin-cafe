# Tên miền trỏ DNS về máy chủ trước khi chạy docker compose.
DOMAIN=order.dukin.vn

# Mật khẩu đăng nhập Trang quản lý /quan-tri.
ADMIN_PASSWORD=doi-mat-khau-nay

# Khóa ký cookie phiên, chuỗi ngẫu nhiên dài bất kỳ.
SESSION_SECRET=sinh-chuoi-ngau-nhien-dai

# Khóa bí mật đính vào messaging endpoint của bot Teams:
# https://DOMAIN/api/teams/events?secret=<giá trị này>
TEAMS_WEBHOOK_SECRET=
